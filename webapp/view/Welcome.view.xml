<mvc:View xmlns:table="sap.ui.table" controllerName="braskem.zui5vetting.controller.Welcome"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:sfb="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable">
    <f:DynamicPage id="dynamicPage" fitContent="true">
        <f:header>
            <f:DynamicPageHeader>
                <f:dependents>
                    <core:CommandExecution command="Enter" enabled="true" />
                </f:dependents>
                <sfb:SmartFilterBar
                    search="cmd:Enter"
                    id="smartFilterBar"
                    entitySet="QuestionnairesSet"
                    enableBasicSearch="false"
                    basicSearchFieldName="IdQuest"
                    persistencyKey="UniqueAndStablePersistencyKey" />

            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <smartTable:SmartTable
                id="smartTable"
                entitySet="QuestionnairesSet"
                smartFilterId="smartFilterBar"
                tableType="Table"
                enableAutoColumnWidth="true"
                useTablePersonalisation="true"
                header="{i18n>Results}"
                requestAtLeastFields="IdQuest,StVettQuest"
                showRowCount="true">
                <smartTable:layoutData>
                    <FlexItemData growFactor="1" baseSize="0%" />
                </smartTable:layoutData>
                <smartTable:customToolbar>
                    <OverflowToolbar>
                        <ToolbarSpacer />
                        <Button text="Create questionnaire" icon="sap-icon://add" 
                        press="onCreateQuestionnaires"/>
                        <Button text="Refresh page" icon="sap-icon://synchronize"
                            press="onRefreshPage" />
                    </OverflowToolbar>
                </smartTable:customToolbar>
                <Table growing="true" growingThreshold="100" mode="None" id="table2"
                    enableBusyIndicator="true" busyIndicatorDelay="100">
                    <columns>
                        <Column width="9rem">
                            <customData>
                                <core:CustomData key="p13nData"
                                    value='\{"columnKey": "actions", "columnIndex": 0}' />
                            </customData>
                            <Text text="{i18n>welcome.actions}" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <HBox>
                                    <Button icon="sap-icon://show" type="Transparent"
                                        tooltip="{i18n>welcome.display}" press=".onDisplayQuestionnaire" />
                                    <!-- Only questionnaires "Em Edição" (01) can be changed -->
                                    <Button icon="sap-icon://edit" type="Transparent"
                                        tooltip="{i18n>welcome.edit}" enabled="{= ${StVettQuest} === '01' }"
                                        press=".onEditQuestionnaire" />
                                    <Button icon="sap-icon://copy" type="Transparent"
                                        tooltip="{i18n>welcome.copy}" press=".onCopyQuestionnaire" />
                                </HBox>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </smartTable:SmartTable>
        </f:content>
    </f:DynamicPage>
</mvc:View>