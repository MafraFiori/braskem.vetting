<mvc:View controllerName="braskem.zui5vetting.controller.Welcome"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:sfb="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable">
    <f:DynamicPage id="dynamicPage" fitContent="true">
        <f:header>
            <f:DynamicPageHeader>
                <f:dependents>
                    <core:CommandExecution command="Enter" enabled="true" />
                </f:dependents>
                <sfb:SmartFilterBar
                    search="cmd:Enter"
                    id="smartFilterBar"
                    entitySet="QuestionnairesSet"
                    enableBasicSearch="true"
                    basicSearchFieldName="IdQuest"
                    persistencyKey="UniqueAndStablePersistencyKey">
                    <sfb:controlConfiguration>
                        <sfb:ControlConfiguration key="IdQuest" index="0"
                            label="Questionnaires" groupId="_BASIC" width="auto"
                            visibleInAdvancedArea="true">
                        </sfb:ControlConfiguration>
                    </sfb:controlConfiguration>
                </sfb:SmartFilterBar>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <smartTable:SmartTable
                id="smartTable"
                entitySet="QuestionnairesSet"
                smartFilterId="smartFilterBar"
                tableType="Table"
                enableAutoColumnWidth="true"
                useTablePersonalisation="true"
                header="{i18n>Results}"
                showRowCount="true"
                initiallyVisibleFields="IdQuest,LoginOwner,DtQuest,HrQuest,StVettQuest,IdVetting,History">
                <smartTable:layoutData>
                    <FlexItemData growFactor="1" baseSize="0%" />
                </smartTable:layoutData>
            </smartTable:SmartTable>
        </f:content>
    </f:DynamicPage>
</mvc:View>