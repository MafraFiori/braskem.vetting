<mvc:View controllerName="braskem.zui5vetting.controller.Questionnaire"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.f"
	xmlns:smartForm="sap.ui.comp.smartform"
	xmlns:smartField="sap.ui.comp.smartfield"
>
	<f:DynamicPage showFooter="true" backgroundDesign="Transparent">
		<f:title>
			<f:DynamicPageTitle>
				<f:breadcrumbs>
					<Breadcrumbs currentLocationText="{i18n>pages.VettingQuestionnaires}">
						<Link text="{i18n>menu.Welcome}" press="navTo('RouteWelcome')" />
					</Breadcrumbs>
				</f:breadcrumbs>
				<f:heading>
					<Title text="{i18n>pages.VettingQuestionnaires}" />
				</f:heading>
				<f:snappedTitleOnMobile>
					<Title text="{i18n>pages.VettingQuestionnaires}" />
				</f:snappedTitleOnMobile>
				<f:actions>
					<Button
						text="Save and submit"
						type="Emphasized"
						press=".toggleAreaPriority" />
					<Button
						text="Save draft"
						type="Transparent" />
				</f:actions>
			</f:DynamicPageTitle>
		</f:title>

		<f:content>
			<VBox justifyContent="SpaceBetween">

				<MessageStrip
					text="The responsible person for filling in, declare under the penalties of the law, that the information provided in this form is complete and undertakes to submit, when requested, the original documents."
					type="Information"
					showIcon="true"
					class="sapUiMediumMarginBottom">
</MessageStrip>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View> 